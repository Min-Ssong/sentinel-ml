# 로컬 개발 전용. 외부 노출 환경에서는 반드시 교체할 것.
# 사용법: 이 파일을 .env 로 복사한 뒤 필요 시 포트 값만 조정
#   cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# 포트 충돌 시 check-ports.ps1 로 확인 후 아래 값을 변경

# --- Credentials ---
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel1234
POSTGRES_DB=sentinel

# --- Ports (host side) ---
ZOOKEEPER_PORT=2281
KAFKA_PORT=9192
REDIS_PORT=6379
POSTGRES_PORT=5432
MLFLOW_PORT=5000
SPRING_API_PORT=8490
FASTAPI_PORT=8495
AIRFLOW_PORT=8481